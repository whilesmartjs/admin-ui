    "nuxt.config.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@whilesmart/design": "^0.2.0",
    "nuxt": "^3.12.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@whilesmart/design": "file:../../whilesmart/design",
    "nuxt": "^3.17.0",
    "vue-tsc": "^3.1.3",
    "vue": "^3.5.0",
    "typescript": "^5.7.0",
    "@iconify-json/solar": "^1.2.10",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "check": "node scripts/check-icons.mjs && node scripts/messages.mjs && node scripts/check-templates.mjs && npm run build && npm test && npm run typecheck",
